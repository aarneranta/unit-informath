cabal-version:      2.4
name:               unit-informath
version:            0.1.0.0
synopsis:           Translating Unit (seg) developments to Dedukti, for Informath
build-type:         Simple

executable unit2dk
    default-language: Haskell2010
    hs-source-dirs:   app, src, ../informath/src/typetheory
    main-is:          Main.hs
    other-modules:    Load, Unit2Dedukti,
                      Dedukti.AbsDedukti, Dedukti.PrintDedukti
    build-depends:    base, containers, directory, seg
    ghc-options:      -O1 -rtsopts
